  "eval": {
    "judge_model": "hy-t2t-glm-5.2-384k-fp8-L20A-t1-v2",
    "judge_max_tokens": 12288,
    "judge_reasoning_effort": "high",
    "shuffle_criteria": true,
    "shuffle_seed": 7,
    "response_variants": [
      "gold",
      "missing_step",
      "numeric_error",
      "right_method_wrong_answer",
      "verbose_empty",
      "terse_correct",
      "off_topic"
    ],
    "metrics": [
      "discriminative",
      "transfer",
      "coverage",
      "intrinsic",
      "headtohead"
    ],
    "self_agreement_repeats": 2,
    "bootstrap_iters": 10000
  },
  "_snapshot_time": "2026-08-28 00:57:00"
