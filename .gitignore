__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
.env

# LLM response cache: reproducible but large and machine-local.
runs/cache/

# runs/websearch_cache/ is deliberately NOT ignored, despite the name.
# runs/cache/ can be regenerated by re-running against the same model; web
# search results cannot — the web changes underneath you. By the rule stated
# below (track what cannot be regenerated from something tracked), the search
# cache is the only record of the web state a rubric was written against, so it
# is an artefact rather than a temporary file. Do not add it here by analogy.

# Run artefacts. The line is: track what a published number is computed from,
# and what cannot be regenerated from something else that is tracked.
#
#   tracked      rubrics_*.jsonl (60 MB)  the objects under study; nothing else
#                                         reconstructs them, and every claim in
#                                         the report is a claim about them
#                metrics/*_per_question_rows.jsonl (27 MB)
#                                         every table is computed from these, so
#                                         without them no figure can be checked
#                rollouts.jsonl (10 MB)   oracle labels and the evidence for the
#                                         16.4% mixed-outcome rate
#                examples.jsonl, *_summary.json, config.json
#
#   not tracked  per-criterion and per-response dumps (~165 MB)
#                                         intermediate: they aggregate into the
#                                         per-question rows above, which are
#                                         tracked. They stay on disk for
#                                         after-the-fact questions on the
#                                         machine that produced them
#                runs/cache/ (249 MB)     machine-local
#
# This keeps the repository around 100 MB of artefacts rather than 360 MB, and
# every number in results/REPORT.md is still re-derivable from what is tracked.
runs/*/traces/
runs/*/metrics/*_per_criterion_rows.jsonl
runs/*/metrics/*_per_response_rows.jsonl
runs/*/metrics/*_per_rollout_rows.jsonl
# Depth-independent: the judge-swap arms sit one level deeper
# (runs/judgeswap_arms/<arm>/...) and a runs/*/ pattern silently misses them.
**/*_per_criterion.jsonl
**/discriminative_verdicts.jsonl
**/discriminative_responses.jsonl
**/discriminative_questions.jsonl
runs/_selftest/
nohup.out
*.log
logs/

# The corpora are inputs, not outputs. analysis/out/*.parquet is derived from
# data/ by code that predates this harness, so it follows the same rule.
data/
analysis/out/*.parquet
*.pdf
runs/*/screening_pool.jsonl

# RubricBench is an upstream repository vendored here as an input, and it
# carries its own .git. Committing it would embed a foreign repository as a
# bare gitlink -- the files would not actually be stored, so it would look
# tracked while being unreproducible for anyone else. Clone it instead:
#   git clone http://github.com/planepig/rubricbench.git
# Our outputs computed from it (results/rubricbench/) are tracked, since no
# other tracked artefact reconstructs them.
#
# The leading slash is load-bearing: an unanchored `rubricbench/` matches a
# directory of that name at ANY depth, which silently swallows
# results/rubricbench/ -- i.e. every artefact the report is computed from.
/rubricbench/
